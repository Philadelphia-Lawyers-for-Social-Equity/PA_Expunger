# Copy to .env and edit to override the defaults in compose.yaml (local
# development) and compose.prod-test.yaml (local production image test).
# Compose reads .env automatically. Never commit .env.

# --- Variables for Standard Development (compose.yaml) ---
DB_USER=plse
DB_PASSWORD=defaultTestPassword
DB_NAME=expunger_db
DJANGO_SECRET_KEY=django-insecure-key_that_is_long_enough_to_not_get_a_warning
SUPERUSER_USERNAME=plse
SUPERUSER_PASSWORD=defaultTestPassword
DJANGO_LOG_LEVEL=INFO

# --- Variables for Production Image Testing (compose.prod-test.yaml) ---
TEST_DB_USER=plse
TEST_DB_PASSWORD=defaultTestPassword
TEST_DB_NAME=expunger_db
TEST_DJANGO_SECRET_KEY=django-insecure-key_that_is_long_enough_to_not_get_a_warning
TEST_SUPERUSER_USERNAME=plse
TEST_SUPERUSER_PASSWORD=defaultTestPassword
TEST_DJANGO_LOG_LEVEL=INFO
TEST_DJANGO_DEBUG=False
TEST_BACKEND_API_URL=http://localhost:8080
TEST_DJANGO_ALLOWED_HOSTS=localhost
# Baked into the image at build time and reported at /static/config.json.
TEST_APP_VERSION=dev
# Prefix the built assets are served under. Baked in at build time.
TEST_STATIC_URL=/static/
